{
  "schema_version": 1,
  "product_name": "nddev-kiro-cli-app",
  "build_version": "0.2.0",
  "runtime": {
    "product": "Kiro CLI",
    "executable": "kiro-cli",
    "current_version": "2.14.2",
    "engine_argument": "--v3",
    "engine_status": "early-access-required",
    "trusted_system_path": "/usr/bin:/bin:/usr/sbin:/sbin",
    "launch_lock_held_until_child_exit": true,
    "lock_mechanism": "fcntl-flock-persistent-file",
    "lock_file_persistent": true,
    "lock_file_mode": "0600",
    "lock_directory_idle_mode": "0700",
    "lock_directory_held_mode": "0500",
    "directory_lock_used": false,
    "ordinary_child_lock_cleanup_denied": true,
    "runtime_mutable_directories_remain_writable": true,
    "mutable_runtime_ancestors_not_chmod_read_only": true,
    "software_launcher_artifact_immutable": true,
    "software_immutable_file_mode": "0400",
    "software_immutable_executable_mode": "0500",
    "software_immutable_directory_mode": "0500",
    "launch_executable_revalidated_before_handoff": true,
    "launch_runtime_directories_target_relative_owner_private": true,
    "managed_launch_blocked_commands": [
      "agent",
      "diagnostic",
      "integrations",
      "launch",
      "login",
      "logout",
      "mcp",
      "settings",
      "update",
      "whoami"
    ],
    "managed_launch_blocked_options": [
      "--agent",
      "--classic",
      "--no-interactive",
      "--require-mcp-startup",
      "--trust-all-tools",
      "--trust-tools",
      "--v3"
    ],
    "baseline": "references/kiro-cli-baseline.json"
  },
  "setup_ids": [
    "nddev-builder"
  ],
  "default_setup_id": "nddev-builder",
  "permission_profile_ids": [
    "safe",
    "full-auto"
  ],
  "default_permission_profile_id": "full-auto",
  "legacy_setup_ids": [
    "safe",
    "balanced",
    "full-auto"
  ],
  "catalog_root": "setups",
  "profile_root": "profiles",
  "manager": {
    "path": "cli-tools/nddev_kiro_cli.py",
    "commands": [
      "list",
      "status",
      "plan",
      "install",
      "update",
      "apply",
      "switch",
      "migrate",
      "restore",
      "remove",
      "software-status",
      "software-probe",
      "software-install",
      "software-update",
      "software-remove",
      "launch"
    ],
    "explicit_target": true,
    "target_environment_variable": "KIRO_HOME"
  },
  "builder": {
    "id": "nddev-builder",
    "status": "default-on",
    "projection": "native-agent-skill-steering",
    "marketplace": null,
    "agent_tools": [
      "*"
    ],
    "native_surfaces": [
      "agents",
      "skills",
      "steering",
      "permissions",
      "workspace_hooks",
      "mcp_configuration"
    ],
    "managed_files": [
      "agents/nddev-builder.md",
      "skills/nddev-builder/SKILL.md",
      "skills/nddev-builder/references/agents-subagents.md",
      "skills/nddev-builder/references/configuration-profiles.md",
      "skills/nddev-builder/references/creator-checker-release.md",
      "skills/nddev-builder/references/hooks.md",
      "skills/nddev-builder/references/installation-lifecycle.md",
      "skills/nddev-builder/references/mcp.md",
      "skills/nddev-builder/references/permissions-sandbox.md",
      "skills/nddev-builder/references/plugins-marketplace.md",
      "skills/nddev-builder/references/skills-instructions.md",
      "steering/nddev-builder.md"
    ]
  },
  "public_validator": "cli-tools/validate_public_contracts.py"
}
