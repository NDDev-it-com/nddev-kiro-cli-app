  "permission_profiles": {
    "default": "full-auto",
    "profile_ids": [
      "safe",
      "full-auto"
    ],
    "vendor_named_profiles": [],
    "profiles": {
      "full-auto": {
        "file": "profiles/full-auto/permissions.yaml",
        "native_rule": {
          "capability": "all",
          "effect": "allow"
        }
      },
      "safe": {
        "file": "profiles/safe/permissions.yaml",
        "native_rules": [
          "deny selected fs_read secret patterns",
          "ask shell, fs_write, web_fetch, web_search, mcp, and subagent",
          "allow skill, diagnostics, and context"
        ]
      }
    }
  },
  "builder": {
    "id": "nddev-builder",
    "status": "default-on",
    "projection": "native-agent-skill-steering",
    "marketplace": null,
    "agent_file": "agents/nddev-builder.md",
    "agent_schema": {
      "format": "Markdown with YAML frontmatter",
      "tools": [
        "*"
      ],
      "resources": [
        "skill://~/.kiro/skills/nddev-builder/SKILL.md",
        "file://~/.kiro/skills/nddev-builder/references/**/*.md",
        "file://~/.kiro/steering/nddev-builder.md"
      ],
      "inline_permissions": false,
      "inline_mcp_servers": false
    },
    "native_surfaces": {
      "agents": "KIRO_HOME/agents and workspace .kiro/agents",
      "skills": "KIRO_HOME/skills and workspace .kiro/skills",
      "steering": "KIRO_HOME/steering and workspace .kiro/steering",
      "hooks": "workspace .kiro/hooks/<name>.json; not target-managed",
      "mcp": "KIRO_HOME/settings/mcp.json, workspace .kiro/settings/mcp.json, or agent mcpServers; not target-managed"
