  "setup_system": {
    "catalog_root": "setups",
    "content_setup_ids": [
      "nddev-builder"
    ],
    "default_setup_id": "nddev-builder",
    "profile_root": "profiles",
    "permission_profile_ids": [
      "safe",
      "full-auto"
    ],
    "default_permission_profile_id": "full-auto",
    "legacy_setup_ids": [
      "safe",
      "balanced",
      "full-auto"
    ],
    "list_command": "python3 cli-tools/nddev_kiro_cli.py list --json",
    "status_command": "python3 cli-tools/nddev_kiro_cli.py status --target /absolute/kiro-home --json",
    "plan_command": "python3 cli-tools/nddev_kiro_cli.py plan --setup nddev-builder --profile full-auto --target /absolute/kiro-home --json",
    "install_command": "python3 cli-tools/nddev_kiro_cli.py install --setup nddev-builder --profile full-auto --target /absolute/kiro-home --json",
    "update_command": "python3 cli-tools/nddev_kiro_cli.py update --target /absolute/kiro-home --json",
    "switch_command": "python3 cli-tools/nddev_kiro_cli.py switch --setup nddev-builder --profile safe --target /absolute/kiro-home --json",
    "migrate_command": "python3 cli-tools/nddev_kiro_cli.py migrate --profile full-auto --target /absolute/kiro-home --json",
    "restore_command": "python3 cli-tools/nddev_kiro_cli.py restore --backup 0 --target /absolute/kiro-home --json",
    "remove_command": "python3 cli-tools/nddev_kiro_cli.py remove --target /absolute/kiro-home --json",
    "launch_command": "python3 cli-tools/nddev_kiro_cli.py launch --target /absolute/kiro-home --",
    "selection_option": "--setup",
    "profile_option": "--profile",
    "plan_mutates": false,
    "future_switch_model": "content setup and permission profile are orthogonal; no balanced profile is exposed without a precise native Kiro meaning"
  },
